\newlabel{fig:arch-v1}{{4.1a}{22}{TrackNet (V1): four-stage VGG encoder-decoder with skip connections and a 256-class intensity head; multiple-in, single-out.\relax }{figure.caption.8}{}}
\newlabel{sub@fig:arch-v1}{{a}{22}{TrackNet (V1): four-stage VGG encoder-decoder with skip connections and a 256-class intensity head; multiple-in, single-out.\relax }{figure.caption.8}{}}
\newlabel{fig:arch-v2}{{4.1b}{22}{TrackNetV2: shallower three-stage backbone that emits one heatmap per input frame in a single multiple-in multiple-out pass.\relax }{figure.caption.8}{}}
\newlabel{sub@fig:arch-v2}{{b}{22}{TrackNetV2: shallower three-stage backbone that emits one heatmap per input frame in a single multiple-in multiple-out pass.\relax }{figure.caption.8}{}}
\newlabel{fig:arch-v3}{{4.1c}{22}{TrackNetV3: the V2 tracker fed an extra median-background channel, followed by an InpaintNet that rectifies the trajectory (shaded).\relax }{figure.caption.8}{}}
\newlabel{sub@fig:arch-v3}{{c}{22}{TrackNetV3: the V2 tracker fed an extra median-background channel, followed by an InpaintNet that rectifies the trajectory (shaded).\relax }{figure.caption.8}{}}
\newlabel{fig:arch-v4}{{4.1d}{22}{TrackNetV4: the V1 backbone with a motion-attention branch (shaded) that gates the decoder towards moving regions; the selected model.\relax }{figure.caption.8}{}}
\newlabel{sub@fig:arch-v4}{{d}{22}{TrackNetV4: the V1 backbone with a motion-attention branch (shaded) that gates the decoder towards moving regions; the selected model.\relax }{figure.caption.8}{}}
\newlabel{fig:arch-v5}{{4.1e}{22}{TrackNetV5: each frame is encoded independently and the three bottleneck features are fused by temporal self-attention (shaded) before decoding the middle frame.\relax }{figure.caption.8}{}}
\newlabel{sub@fig:arch-v5}{{e}{22}{TrackNetV5: each frame is encoded independently and the three bottleneck features are fused by temporal self-attention (shaded) before decoding the middle frame.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture of the five TrackNet-family variants compared in this chapter. All share an encoder-decoder backbone that ingests stacked frames and produces a spatial output decoded to a ball coordinate; they differ in the output representation and in the temporal module each one adds, shaded for the trajectory rectifier of V3, the motion attention of V4, and the temporal self-attention of V5.\relax }}{22}{figure.caption.8}\protected@file@percent }
\newlabel{fig:ball-arch}{{4.1}{22}{Architecture of the five TrackNet-family variants compared in this chapter. All share an encoder-decoder backbone that ingests stacked frames and produces a spatial output decoded to a ball coordinate; they differ in the output representation and in the temporal module each one adds, shaded for the trajectory rectifier of V3, the motion attention of V4, and the temporal self-attention of V5.\relax }{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces Training configuration of the six models. All used a reduce-on-plateau learning-rate schedule and early stopping; they differ in optimiser, loss, and budget. The two 256-class models (V1, V4) use Adadelta with cross-entropy; the heatmap models use Adam.\relax }}{23}{table.caption.9}\protected@file@percent }
\newlabel{tab:ball-train}{{4.2}{23}{Training configuration of the six models. All used a reduce-on-plateau learning-rate schedule and early stopping; they differ in optimiser, loss, and budget. The two 256-class models (V1, V4) use Adadelta with cross-entropy; the heatmap models use Adam.\relax }{table.caption.9}{}}
